# Local deployment settings (non-secret template). Copy to .env:  cp deploy.env .env
# .env stays gitignored; put any secrets (ops token, Postgres password) only there.

COMPOSE_FILE=compose.prod.yml:compose.nginx.yml

UNISSH_DOMAIN=ttllkk-new.zapto.org
UNISSH__SERVER__PUBLIC_URL=https://ttllkk-new.zapto.org/unissh

UNISSH__DB__BACKEND=sqlite
UNISSH__DB__URL=/app/data/unissh.db
